<Window x:Class="ArcaneRushSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arcane Rush Sync"
        Width="1280" Height="720"
        MinWidth="1060" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0A0909"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Grid>
        <Image Source="Assets/Background.png" Stretch="UniformToFill"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#E907090B" Offset="0"/>
                    <GradientStop Color="#B50A0B0D" Offset="0.40"/>
                    <GradientStop Color="#4A08090A" Offset="0.67"/>
                    <GradientStop Color="#18000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border Background="#22000000" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Top" Height="58"/>

        <Grid Margin="54,34,54,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#D91B1712" BorderBrush="#B7E7B45A" BorderThickness="1">
                        <TextBlock Text="AR" Foreground="#F1C66F" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="ARCANE RUSH" Foreground="#FFF8EE" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="SYNC" Foreground="#E7B65B" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Visibility="Collapsed"
                            Style="{StaticResource PrimaryButton}" Padding="13,7" FontSize="12" Margin="0,0,9,0"
                            Click="Update_Click" Content="MAJ DISPONIBLE" ToolTip="Télécharger et installer la dernière version GitHub"/>
                    <Button x:Name="LogoutButton" Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12"
                            Click="Logout_Click" Content="Se déconnecter"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="LoginView" Grid.Row="1" Width="500" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Background="#D5161515" BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="20" Padding="34">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.40" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Bienvenue" Foreground="#FFF8EE" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock Text="Connecte ton compte Arcane Rush Companion. Ensuite, clique sur Synchroniser avant de lancer Arcane Rush normalement." 
                                   Foreground="#BFC3C0BA" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,26" LineHeight="21"/>

                        <TextBlock Text="Adresse e-mail" Foreground="#E9E6DE" FontSize="13" Margin="2,0,0,8"/>
                        <TextBox x:Name="EmailBox" Style="{StaticResource InputTextBox}" Height="46"/>

                        <TextBlock Text="Mot de passe" Foreground="#E9E6DE" FontSize="13" Margin="2,18,0,8"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" Height="46"/>

                        <Button x:Name="EmailLoginButton" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"
                                Click="EmailLogin_Click" Content="Se connecter" Height="48"/>

                        <Grid Margin="0,20,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#42FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ou" Foreground="#9EB0AAA1" Margin="12,0"/>
                            <Border Grid.Column="2" Height="1" Background="#42FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <Button x:Name="GoogleLoginButton" Style="{StaticResource SecondaryButton}" Height="48"
                                Click="GoogleLogin_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#FFF9F7F2" Margin="0,0,10,0">
                                    <TextBlock Text="G" Foreground="#3C4043" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Continuer avec Google" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="LoginStatusText" Foreground="#E8C47B" FontSize="12" TextWrapping="Wrap" Margin="2,18,2,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="HomeView" Grid.Row="1" Visibility="Collapsed">
                <StackPanel Width="610" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Background="#C9141414" BorderBrush="#3EFFFFFF" BorderThickness="1" CornerRadius="20" Padding="30">
                        <StackPanel>
                            <TextBlock Text="PRÊT À SYNCHRONISER" Foreground="#E7B65B" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="WelcomeText" Text="Bonjour" Foreground="#FFF8EE" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="Le scanner reste local. Il ne conserve aucun paquet réseau brut et synchronise uniquement ton pseudo Arcane Rush, ta collection et tes 13 decks." 
                                       Foreground="#C0C5C1BA" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,24"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#80101214" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,7,0">
                                    <StackPanel>
                                        <TextBlock Text="JOUEUR" Foreground="#9EAAA59D" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PlayerNameText" Text="En attente…" Foreground="#FFF8EE" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#80101214" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="7,0,7,0">
                                    <StackPanel>
                                        <TextBlock Text="COLLECTION" Foreground="#9EAAA59D" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CollectionCountText" Text="En attente…" Foreground="#FFF8EE" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#80101214" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="7,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DECKS" Foreground="#9EAAA59D" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DeckCountText" Text="0 / 13" Foreground="#FFF8EE" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#6F0E1112" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                                <DockPanel>
                                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#E6B75D" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="Clique sur « Synchroniser avec le site », puis lance Arcane Rush normalement." Foreground="#D6D3CC" FontSize="13" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="HomeActions" Grid.Row="2" Visibility="Collapsed" Width="610" HorizontalAlignment="Left" Margin="0,0,0,4">
                <Button x:Name="SyncButton" Style="{StaticResource ActionButton}" Height="66"
                        Background="#D7D2C181" BorderBrush="#E8E7D5A0" Click="Sync_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↻" FontSize="21" Margin="0,0,11,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="SYNCHRONISER AVEC LE SITE" FontWeight="Bold" FontSize="15"/>
                            <TextBlock x:Name="SyncSubText" Text="Clique ici avant de lancer le jeu" FontSize="11" Opacity="0.75" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
