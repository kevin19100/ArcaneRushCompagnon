<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Configuration deliberately local to Arcane Rush Sync.
    It prevents a missing/disabled user NuGet source or PackageSourceMapping
    from breaking the one-click test build.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
</configuration>
